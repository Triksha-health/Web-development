# Frontend environment variables — copy to .env and fill in.
# In production these are set in the Netlify dashboard.

# Backend origin (NO trailing slash, NO /api suffix). API paths are mounted under ${VITE_API_URL}/api/...
VITE_API_URL=https://triksha-backend-f5f0cth4f9c0b8g9.southindia-01.azurewebsites.net

# Realtime socket endpoint (optional)
VITE_WEBSOCKET_URL=wss://triksha-backend-f5f0cth4f9c0b8g9.southindia-01.azurewebsites.net/ws

# Privacy-friendly visitor analytics. Set ONE of these; leave both blank to disable.
# Umami Cloud (free plan): the Website ID from Umami, Settings, Websites.
VITE_UMAMI_WEBSITE_ID=
# Plausible (paid): the site domain, e.g. trikshahealth.com.
VITE_PLAUSIBLE_DOMAIN=
