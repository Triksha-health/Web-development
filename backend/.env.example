# Backend environment variables — copy to .env and fill in real values.
# Never commit the real .env (it is gitignored).

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth
JWT_SECRET=<long-random-string>
SESSION_SECRET=<different-long-random-string>   # required — server refuses to boot without it

# Admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<admin-password>

# Razorpay
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=https://<backend-host>/auth/google/callback

# Email (SMTP)
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-pass>
FROM_EMAIL=no-reply@trikshahealth.com
